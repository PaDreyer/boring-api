{
  "name": "boring-api",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r run build",
    "dev": "pnpm --filter \"./packages/*\" -r --parallel run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "node scripts/check-workspaces.js && pnpm -r run test",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "example:dev": "pnpm --filter @boringapi/example-basic dev",
    "example:check": "pnpm --filter @boringapi/example-basic check",
    "example:inspect": "pnpm --filter @boringapi/example-basic inspect",
    "example:sync": "pnpm --filter @boringapi/example-basic sync",
    "example:build": "pnpm --filter @boringapi/example-basic build",
    "example:start": "pnpm --filter @boringapi/example-basic start",
    "example:fullstack:sync": "pnpm --filter @boringapi/example-fullstack sync",
    "example:fullstack:check": "pnpm --filter @boringapi/example-fullstack check",
    "example:fullstack:inspect": "pnpm --filter @boringapi/example-fullstack inspect",
    "example:fullstack:dev": "pnpm --filter @boringapi/example-fullstack dev",
    "example:fullstack:web": "pnpm --filter @boringapi/example-fullstack web",
    "example:fullstack:migrate": "pnpm --filter @boringapi/example-fullstack migrate",
    "example:fullstack:build": "pnpm --filter @boringapi/example-fullstack build",
    "example:fullstack:start": "pnpm --filter @boringapi/example-fullstack start",
    "pack:packages": "node scripts/pack-packages.js"
  }
}
