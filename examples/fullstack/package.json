{
  "name": "@boringapi/example-fullstack",
  "private": true,
  "scripts": {
    "dev": "boring dev --port 4041",
    "check": "boring check",
    "inspect": "boring inspect",
    "sync": "boring sync",
    "typecheck": "boring check",
    "build": "boring build && vite build --config web/vite.config.mjs",
    "start": "node dist/server.js",
    "test": "node --test -r ts-node/register -r ./test/register.ts test/*.test.ts",
    "web": "vite --config web/vite.config.mjs",
    "migrate": "ts-node -r ./register-source.ts migrate.ts"
  },
  "dependencies": {
    "@boringapi/core": "workspace:^",
    "zod": "^3.20.2",
    "express": "^4.18.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.17",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4",
    "@types/express": "^4.17.15",
    "@types/pg": "8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
