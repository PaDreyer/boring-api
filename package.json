{
  "name": "@boringapi/core",
  "version": "0.0.1",
  "description": "Convention-driven, file-based APIs for Node.js and TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "client": ["dist/client.d.ts"],
      "register": ["dist/register.d.ts"]
    }
  },
  "bin": { "boring": "./dist/cli.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "require": "./dist/register.js",
      "default": "./dist/register.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "author": "Paul Dreyer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaDreyer/boring-api.git"
  },
  "bugs": {
    "url": "https://github.com/PaDreyer/boring-api/issues"
  },
  "homepage": "https://github.com/PaDreyer/boring-api#readme",
  "keywords": ["api", "filesystem", "typescript", "express", "convention"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "example:dev": "ts-node src/cli.ts dev examples/basic/api",
    "example:check": "ts-node src/cli.ts check examples/basic/api",
    "example:inspect": "ts-node src/cli.ts inspect examples/basic/api",
    "example:sync": "ts-node src/cli.ts sync examples/basic/api",
    "example:build": "ts-node src/cli.ts build examples/basic/api --project tsconfig.example.json",
    "example:start": "ts-node examples/basic/server.ts",
    "example:fullstack:sync": "ts-node src/cli.ts sync examples/fullstack/api --project tsconfig.fullstack.json",
    "example:fullstack:check": "ts-node src/cli.ts check examples/fullstack/api --project tsconfig.fullstack.json",
    "example:fullstack:dev": "ts-node src/cli.ts dev examples/fullstack/api --port 4041 --project tsconfig.fullstack.json",
    "example:fullstack:web": "vite --config examples/fullstack/web/vite.config.mjs",
    "example:fullstack:migrate": "ts-node --project tsconfig.fullstack.json examples/fullstack/migrate.ts",
    "example:fullstack:build": "ts-node src/cli.ts build examples/fullstack/api --project tsconfig.fullstack.json && vite build --config examples/fullstack/web/vite.config.mjs",
    "example:fullstack:start": "node .boring/fullstack-build/examples/fullstack/server.js",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test -r ts-node/register -r ./test/register.ts test/*.test.ts",
    "prepack": "node scripts/build.js"
  },
  "dependencies": {
    "@types/express": "^4.17.15",
    "@types/node": "^18.11.17",
    "express": "^4.18.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4"
  },
  "peerDependencies": {
    "zod": "^3.20.2"
  },
  "resolutions": {
    "@types/pg/pg-protocol": "1.7.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "zod": "^3.20.2"
  }
}
