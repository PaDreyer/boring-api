{
  "name": "@boringapi/core",
  "version": "0.0.1",
  "description": "Convention-driven, file-based APIs for Node.js and TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "boring": "./dist/cli.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "author": "Paul Dreyer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaDreyer/boring-api.git"
  },
  "bugs": {
    "url": "https://github.com/PaDreyer/boring-api/issues"
  },
  "homepage": "https://github.com/PaDreyer/boring-api#readme",
  "keywords": ["api", "filesystem", "typescript", "express", "convention"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "example:dev": "ts-node src/cli.ts dev examples/basic/api",
    "example:check": "ts-node src/cli.ts check examples/basic/api",
    "example:inspect": "ts-node src/cli.ts inspect examples/basic/api",
    "example:sync": "ts-node src/cli.ts sync examples/basic/api",
    "example:start": "ts-node examples/basic/server.ts",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test -r ts-node/register test/*.test.ts",
    "prepack": "node scripts/build.js"
  },
  "dependencies": {
    "@types/express": "^4.17.15",
    "@types/node": "^18.11.17",
    "express": "^4.18.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4"
  },
  "peerDependencies": {
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "zod": "^3.20.2"
  }
}
